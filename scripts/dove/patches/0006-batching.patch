+    fn found(frame: Value, enabled: Option<bool>) -> Found {
+        let mut element = json!({"role": "AXButton", "label": "Go", "element_token": "s1:1", "frame": frame});
+        if let Some(enabled) = enabled {
+            element["enabled"] = json!(enabled);
+        }
+        Found {
+            window: Window {
+                pid: 1,
+                window_id: 2,
+                app: None,
+                title: None,
+                on_screen: true,
