+            automation,
+            &cache_req,
+            target_pid,
+            &mut nodes,
+            &mut lines,
+            &mut counter,
+            budget,
+            max_depth,
+        );
+        if !nodes.iter().any(|n| n.element_index.is_some()) {
+            release_walk_nodes(nodes);
+            return None;
+        }
+        Some(UiaTreeResult {
+            tree_markdown: render_lines(&lines),
+            nodes,
