# Optional W9 grounder weights shipped as a separate release asset.
# Path relative to the fork root. The release skips the asset when the file is missing.
# To fetch pinned weights instead of committing them, set GROUNDER_URL and GROUNDER_SHA256
# (the release then downloads and checks them, and ignores GROUNDER_WEIGHTS).
GROUNDER_WEIGHTS=models/grounder/dove-grounder-fp16.onnx
GROUNDER_FORMAT=onnx
GROUNDER_PRECISION=fp16
GROUNDER_URL=
GROUNDER_SHA256=
